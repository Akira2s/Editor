{
  "schema": 1,
  "_about": "Everything the ComfyUI installer (comfyui-setup.mjs) installs is defined here. Edit this file to change a tier: move a model id between lists, add a model entry, change a minimum VRAM. Run `node setup/refresh-model-sizes.mjs` after adding a model so its size and checksum are filled in. A tier 'extends' another one and only lists the stages that differ.",
  "vramToleranceFactor": 0.95,
  "comfyui": {
    "repo": "https://github.com/comfyanonymous/ComfyUI.git",
    "commit": "fb3befd168731438f88bc96e0920a538e8649878",
    "python": "3.11",
    "torch": {
      "index": "https://download.pytorch.org/whl/cu128",
      "packages": [
        "torch==2.11.0",
        "torchvision==0.26.0",
        "torchaudio==2.11.0"
      ]
    },
    "extraPackages": {
      "win32": [
        "triton-windows==3.8.0.post29"
      ]
    }
  },
  "customNodes": [
    {
      "name": "ComfyUI-UltraTex",
      "repo": "https://github.com/visualbruno/ComfyUI-UltraTex.git",
      "commit": "8137da52ed8352305cb7825b39c36a250bf2507a"
    },
    {
      "name": "ComfyUI_AdvancedRefluxControl",
      "repo": "https://github.com/kaibioinfo/ComfyUI_AdvancedRefluxControl.git",
      "commit": "2b95c2c866399ca1914b4da486fe52808f7a9c60"
    }
  ],
  "mcp": {
    "repo": "https://github.com/Akira2s/ComfyUI-MCP.git",
    "dir": "ComfyUI-MCP"
  },
  "stageLabels": {
    "textToImage": "Text to image",
    "referenceImage": "Image from a reference",
    "turnaround": "Character turnaround views",
    "meshFromImage": "Mesh from one image",
    "meshFromViews": "Mesh from multiple views",
    "helpers": "Helpers (background removal, geometry)"
  },
  "tiers": {
    "ultra": {
      "label": "Ultra",
      "minVramGb": 24,
      "extends": "high",
      "status": "provisional: same models as High until measured on a 24 GB card",
      "notes": [
        "Pixal3D at 1536 may need more than 24 GB (a third-party wrapper measured about 32 GB); not verified with the native nodes."
      ]
    },
    "high": {
      "label": "High",
      "minVramGb": 16,
      "status": "reference: the setup this project was built and verified on (RTX 4070 Ti SUPER, 16 GB)",
      "stages": {
        "textToImage": {
          "models": [
            "flux1_dev_fp8"
          ]
        },
        "referenceImage": {
          "models": [
            "flux1_redux_dev",
            "sigclip_vision_384"
          ]
        },
        "turnaround": {
          "models": [
            "klein_base_9b_fp8",
            "qwen3_8b_fp8mixed",
            "flux2_vae",
            "tripleview_klein9b"
          ]
        },
        "meshFromImage": {
          "models": [
            "pixal3d_bf16",
            "dino_v3_l_naf",
            "trellis2_shape_vae",
            "trellis2_texture_vae"
          ]
        },
        "meshFromViews": {
          "models": [
            "pixal3d_multiview_int8"
          ]
        },
        "helpers": {
          "models": [
            "birefnet",
            "moge2"
          ]
        }
      },
      "mcpEnv": {}
    },
    "medium": {
      "label": "Medium",
      "minVramGb": 12,
      "extends": "high",
      "status": "proposed, not measured: only the mesh stages are lowered; the other stages keep the High models and rely on ComfyUI offloading",
      "stages": {
        "meshFromImage": {
          "models": [
            "pixal3d_int8",
            "dino_v3_l_naf",
            "trellis2_shape_vae",
            "trellis2_texture_vae"
          ]
        }
      },
      "mcpEnv": {
        "COMFY_PIXAL3D_UNET": "pixal3d_int8_convrot.safetensors",
        "COMFY_TRELLIS_RESOLUTION": "1024"
      },
      "planned": [
        "Text to image: FLUX.2 Klein 4B fp8 (Apache-2.0, 4.1 GB), replacing the 17 GB FLUX.1 dev; needs a new graph in the MCP",
        "Turnaround: Klein 9B GGUF Q5_K_M with a Qwen3-8B GGUF encoder; needs GGUF loader nodes in the MCP graph"
      ]
    },
    "low": {
      "label": "Low",
      "minVramGb": 8,
      "extends": "medium",
      "status": "proposed, not measured: Trellis2 at 512 for single-image meshes; the other stages are as in Medium and may be slow or fail on 8 GB",
      "stages": {
        "meshFromImage": {
          "models": [
            "trellis2_int8",
            "dino_v3_l_naf",
            "trellis2_shape_vae",
            "trellis2_texture_vae"
          ]
        }
      },
      "mcpEnv": {
        "COMFY_SHAPE_MODEL": "trellis2",
        "COMFY_TRELLIS_RESOLUTION": "512"
      },
      "planned": [
        "Mesh: Hunyuan3D-2mini-turbo (3.8 GB) as an alternative shape model; needs a preset in the MCP (its license excludes the EU, UK and South Korea)"
      ]
    }
  },
  "optionalGroups": {
    "ultratex": {
      "label": "UltraTex texturing (needs the Klein 9B models of the turnaround stage)",
      "models": [
        "ultratex_flux2_lora",
        "ultratex_flux2_mr_lora",
        "ultratex_flux2_decoder",
        "ultratex_flux1_lora",
        "ultratex_flux1_decoder"
      ]
    },
    "altShapeModels": {
      "label": "Alternative shape models (Trellis2 int8, Pixal3D int8, Hunyuan3D 2.1)",
      "models": [
        "trellis2_int8",
        "pixal3d_int8",
        "hunyuan3d_v2_1"
      ]
    }
  },
